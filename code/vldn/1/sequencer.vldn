outputs_count = 8
value = std::get_current_value()
// react only on a falling edge / after the pulse
if (value == true) {
    return
}

fn reset_all(count) {
    i = 1
    while (i <= count) {
        std::set_output(str::fmt("o{}", i), false)
        i += 1
    }
    std::set_output("off", false)
}

fn move(index, steps) {
    max_index = std::get_config("max_index")
    new_index = index + steps
    if (new_index > max_index) {
        new_index = 0
    } else if (new_index < 0) {
        new_index = max_index
    }

    std::set_state("sequence_index", new_index)
    return new_index
}

channel = std::get_current_channel()
index = std::get_state("sequence_index")

new_index = index

if (channel == "reset") {
    new_index = move(index, -index)
}

if (channel == "forward") {
    new_index = move(index, 1)
}

if (channel == "backward") {
    new_index = move(index, -1)
}

reset_all(outputs_count)
if (new_index == 0) {
    std::set_output("off", true)
} else {
    std::set_output(str::fmt("o{}", new_index), true)
}
