value = std::get_current_value()
if (value == false) {
    return
}

channel = std::get_current_channel()
index = std::get_state("sequence_index")
max_index = std::get_config("max_index")

new_index = index

if (channel == "reset" and value) {
    new_index = 0
    std::set_state("sequence_index", new_index)
}

if (channel == "forward" and value) {
    new_index = index + 1
    if (new_index > max_index) {
        new_index = 0
    }

    std::set_state("sequence_index", new_index)
}

if (channel == "backward" and value) {
    new_index = index - 1
    if (new_index < 0) {
        new_index = max_index
    }

    std::set_state("sequence_index", new_index)
}

off = false
o1 = false
o2 = false
o3 = false
o4 = false

if (new_index == 0) {
    off = true
}
if (new_index == 1) {
    o1 = true
}
if (new_index == 2) {
    o2 = true
}
if (new_index == 3) {
    o3 = true
}
if (new_index == 4) {
    o4 = true
}

std::set_output("off", off)
std::set_output("o1", o1)
std::set_output("o2", o2)
std::set_output("o3", o3)
std::set_output("o4", o4)
