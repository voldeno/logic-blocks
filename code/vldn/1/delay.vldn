channel = std::get_current_channel()
value = std::get_current_value()

don_ms = math::round(std::get_config("don") * 1000)
doff_ms = math::round(std::get_config("doff") * 1000)

// Handle callback execution
if (channel == "callback") {
    if (value == 1) {
        // Delay on callback - set output to true
        std::set_output("output", true)
        return
    }
    
    if (value == 2) {
        // Delay off callback - set output to false
        std::set_output("output", false)
        return
    }
    
    return
}

// Handle input changes - detect edges
if (channel == "trigger") {
    last_trigger_state = std::get_state("last_trigger_state")
    
    // Only react to state changes (edges)
    if (value != last_trigger_state) {
        std::set_state("last_trigger_state", value)
        
        if (value) {
            // Input went high - schedule delay on
            std::clear_callback()
            if (don_ms > 0) {
                std::callback(don_ms, 1)
            } else {
                // If delay is 0, set output immediately
                std::set_output("output", true)
            }
        } else {
            // Input went low - schedule delay off
            std::clear_callback()
            if (doff_ms > 0) {
                std::callback(doff_ms, 2)
            } else {
                // If delay is 0, set output immediately
                std::set_output("output", false)
            }
        }
    }
    return
}
