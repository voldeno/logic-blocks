climate_control = std::get_input("climate_control")

if (climate_control > 0) {
    std::set_output("heating", true)
    std::set_output("cooling", false)
}

if (climate_control < 0) {
    std::set_output("heating", false)
    std::set_output("cooling", true)
}

if (climate_control == 0) {
    std::set_output("heating", false)
    std::set_output("cooling", false)
}
