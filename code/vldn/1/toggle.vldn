channel = std::get_current_channel()
value = std::get_current_value()

// Handle input changes - detect rising edges only
if (channel == "input") {
    last_input_state = std::get_state("last_input_state")
    
    // Only react to rising edge (false -> true)
    if (value and !last_input_state) {
        // Toggle the output
        std::set_output("output", !std::get_output("output"))
    }
    
    std::set_state("last_input_state", value)
}
