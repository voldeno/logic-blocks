air_temp = std::get_input("air_temp")
floor_temp = std::get_input("floor_temp")
door_window_contact = std::get_input("door_window_contact")

comfort_temp = std::get_config("comfort_temp")
eco_temp = std::get_config("eco_temp")
temp_hysteresis = std::get_config("temp_hysteresis")
max_floor_temp = std::get_config("max_floor_temp")

climate_control = std::get_output("climate_control")

// TODO: floor_temp might be missing - handle optional input
floor_overheated = (floor_temp + temp_hysteresis) >= max_floor_temp
heating_required = air_temp < (comfort_temp - temp_hysteresis)

if (floor_overheated) {
    // overheated
    climate_control = 0
} else {
    if (air_temp < (comfort_temp - temp_hysteresis)) {
        // temp. too low
        climate_control = 10
    }
    if ((air_temp > (comfort_temp - temp_hysteresis)) and (air_temp < (comfort_temp + temp_hysteresis))) {
        // temp. in hysteresis
        // no change in value
    }
    if (air_temp > (comfort_temp + temp_hysteresis)) {
        // temp. too high
        climate_control = 0
    }
}

std::set_output("climate_control", climate_control)
