channel = std::get_current_channel()

section_count = 8

fn disable_all(section_count) {
    section = 0
    while (section < section_count) {
        section += 1
        std::set_output(str::fmt("section_{}", section), false)
    }
}

if (channel == "callback") {
    disable_all(section_count)

    current_section = 0
    callback_id = std::get_current_value()
    if (callback_id == 0) {
        std::set_output("pump", true)
        std::callback(0, 1)
        return
    } else if (callback_id > 0 and callback_id < (section_count + 1)) {
        current_section = callback_id
    } else if (callback_id == (section_count + 1)) {
        std::set_output("pump", false)
        std::set_state("active", false)
        return
    }

    section_output = str::fmt("section_{}", current_section)
    section_enabled_cfg = str::fmt("s{}_enabled", current_section)
    section_duration_cfg = str::fmt("s{}_duration", current_section)

    section_enabled = std::get_config(section_enabled_cfg)
    section_duration = std::get_config(section_duration_cfg)

    if (!section_enabled) {
        std::callback(0, current_section + 1)
        return
    }

    std::set_output(section_output, true)
    std::callback(section_duration * 1000, current_section + 1)
    return
}

input_value = std::get_current_value()

if (channel == "trigger" and input_value) {
    if (std::get_state("active")) {
        return
    }

    std::set_state("active", true)
    std::callback(0, 0)
    return
}

if (channel == "reset") {
    std::clear_callback()
    std::callback(0, section_count + 1)
    return
}
