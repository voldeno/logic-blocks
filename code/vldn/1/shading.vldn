callback_ms = 100
callback_ms_real = 99 // leave a bit room for callback scheduling to get precise 100ms

channel = get_current_channel()
value = get_current_value()
shading_type = get_config("shading_type")

// slats exists only for venetian blinds, so ensure they are zeroed for other configurations
if (shading_type != 0 and get_state("slats") != 0) {
    set_state("slats", 0)
}

if (channel == "callback") {
    steps_left = get_state("steps_left")
    steps_left -= 1
    if (steps_left <= 0) {
        steps_left = 0
    }
    set_state("steps_left", steps_left)

    last_slats = get_state("slats")
    current_slats = last_slats

    last_position = get_state("position")
    current_position = last_position

    if (value == 1 or value == 3) { // opening callback - full_open and slightly_open
        if (shading_type == 0) { // slats exists only for venetian blinds
            if (get_config("slightly_open_duration") == 0) { // handle division by zero
                current_slats = 0
                last_slats = current_slats
            } else {
                current_slats = last_slats - (((100 * callback_ms) / (2 * get_config("slightly_open_duration") * 1000.0)))
            }
            if (current_slats <= 0) {
                current_slats = 0
            }
        }

        if (round(last_slats) <= 0) { // slats fully moved, start changing position
            current_position = last_position + (((100 * callback_ms) / (get_config("opening_duration") * 1000.0)))
            if (current_position >= 100) {
                current_position = 100
            }
        }

        set_state("slats", current_slats)
        set_output("slats", round(current_slats))
        set_state("position", current_position)
        set_output("position", round(current_position))

        if (steps_left > 0) {
            callback(callback_ms_real, value)
        } else if (value == 1 or (value == 3 and shading_type != 0)) { // full_open
            set_output("open", false)
        } else if (value == 3) { // slightly_open for venetian blinds
            set_output("open", false)
            slightly_open_steps = (1000 * get_config("slightly_open_duration")) / callback_ms
            if (slightly_open_steps == 0) {
                return
            }
            set_output("close", true)
            set_state("steps_left", slightly_open_steps)
            callback(0, 2)
            return
        }
        return
    }

    if (value == 2) { // closing callback - full_close
        if (shading_type == 0) { // slats exists only for venetian blinds
            if (get_config("slightly_open_duration") == 0) { // handle division by zero
                current_slats = 100
                last_slats = current_slats
            } else {
                if (last_slats <= 0 and last_position <= 0) {
                    // prevent a 0 -> 100 move for slats in closed blind position
                    current_slats = 0
                } else {
                    current_slats = last_slats + ((100 * callback_ms) / (2 * get_config("slightly_open_duration") * 1000.0))
                }
            }

            if (current_slats >= 100) {
                current_slats = 100
            }

            if (last_slats == 100) { // slats fully moved, start changing position
                current_position = last_position - ((100 * callback_ms) / (get_config("closing_duration") * 1000.0))
                if (current_position <= 0) {
                    current_position = 0
                }
            }

        } else { // other shading types
            current_position = last_position - ((100 * callback_ms) / (get_config("closing_duration") * 1000.0))
            if (current_position <= 0) {
                current_position = 0
            }
        }

        set_state("slats", current_slats)
        // 0 and 100 positions are the same when fully closed
        if (round(current_position) == 0 and (round(current_slats) == 0 or round(current_slats) == 100)) {
            set_output("slats", 0)
        } else {
            set_output("slats", round(current_slats))
        }
        set_state("position", current_position)
        set_output("position", round(current_position))

        if (steps_left > 0) {
           callback(callback_ms_real, 2)
        } else {
           set_output("close", false)
        }
        return
    }

    return
}

if (get_state("slats") >= 100 and get_state("position") <= 0) {
    // 0 and 100 position of slats are equal on position == 0
    set_state("slats", 0)
}

full_opening_steps = (1000 * get_config("opening_duration")) / callback_ms
full_opening_steps_left = full_opening_steps * (100 - get_state("position")) / 100.0
full_closing_steps = (1000 * get_config("closing_duration")) / callback_ms
slats_full_rotation_steps = (1000 * 2 * get_config("slightly_open_duration")) / callback_ms
if (shading_type != 0) { // slats are present only for venetian blinds
    slats_full_rotation_steps = 0
}
slats_full_rotation_steps_left_opening = slats_full_rotation_steps * get_state("slats") / 100.0
slats_full_rotation_steps_left_closing = slats_full_rotation_steps * (100 - get_state("slats")) / 100.0
steps_left_opening = round(full_opening_steps_left + slats_full_rotation_steps_left_opening)
steps_left_closing = round(full_closing_steps + slats_full_rotation_steps)

if (channel == "part_open") {
    if (get_input("wind_alarm") or get_input("off") or get_input("dwc")) {
        return
    }

    clear_callback()
    set_output("close", false)

    if (value and steps_left_opening != 0) {
        set_output("open", true)
        set_state("was_opening", true)
        set_state("steps_left", steps_left_opening)
        callback(callback_ms_real, 1)
    } else {
        set_output("open", false)
    }
    return
}

if (channel == "part_close") {
    if (get_input("wind_alarm") or get_input("off") or get_input("dwc")) {
        return
    }

    clear_callback()
    set_output("open", false)
    set_output("close", value)
    set_state("was_opening", false)

    if (value) {
        set_state("steps_left", steps_left_closing)
        callback(callback_ms_real, 2)
    }
    return
}

if (channel == "dwc") {
    if (get_input("wind_alarm") or get_input("off") or !value) {
        return
    }
    // do not activate if already open
    if (get_state("position") <= 0) {
        return
    }

    set_state("steps_left", steps_left_closing)
    set_output("open", false)
    set_output("close", true)
    set_state("was_opening", false)
    callback(callback_ms_real, 2)
}

if (channel == "wind_alarm") {
    if (get_input("off") or !value) {
        return
    }

    clear_callback()
    wap = get_config("wind_alarm_position")

    // position_diff - percentage:
    // zero - ok
    // negative - need to move in closing direction
    // positive - need to move in opening direction
    position_diff = -100
    if (wap != 0) { // use diff only if wap is not fully-closed
        position_diff = wap - get_state("position")
    }

    if (position_diff == 0) {
        return
    }

    if (position_diff < 0) { // closing
        set_output("open", false)
        set_output("close", true)
        set_state("was_opening", false)
        full_closing_steps = (1000 * get_config("closing_duration")) / callback_ms
        set_state("steps_left", full_closing_steps * -position_diff / 100 + slats_full_rotation_steps_left_closing)
        callback(callback_ms_real, 2)
    } else { // opening
        set_output("open", true)
        set_output("close", false)
        set_state("was_opening", true)
        full_opening_steps = (1000 * get_config("opening_duration")) / callback_ms
        set_state("steps_left", full_opening_steps * position_diff / 100 + slats_full_rotation_steps_left_opening)
        callback(callback_ms_real, 1)
    }
    return
}

if (channel == "off") {
    if (value) { // reset on raising edge, no-op on fall
        clear_callback()
        set_output("open", false)
        set_output("close", false)
        return
    }
}

// pulse signals below
if (value == true) {
    return
}

if (channel == "toggle") {
    if (get_input("wind_alarm") or get_input("off") or get_input("dwc")) {
        return
    }

    if (get_output("open") or get_output("close")) { // stop on movement
        clear_callback()
        set_output("open", false)
        set_output("close", false)
    } else if (get_state("was_opening")) { // toggle to closing
        set_state("was_opening", false)
        set_output("open", false)
        set_output("close", true)

        set_state("steps_left", steps_left_closing)
        callback(callback_ms_real, 2)
    } else { // toggle to opening
        set_state("was_opening", true)
        set_output("open", true)
        set_output("close", false)

        set_state("steps_left", steps_left_opening)
        callback(callback_ms_real, 1)
    }
    return
}

if (channel == "full_open" or channel == "slightly_open") {
    if (get_input("wind_alarm") or get_input("off") or get_input("dwc")) {
        return
    }

    if (get_output("open")) { // stops if in motion
        clear_callback()
        set_state("steps_left", 0)
        set_output("open", false)
        return
    }

    callback_id = 1
    if (channel == "slightly_open") {
        callback_id = 3
    }

    steps_left = 0
    if (shading_type == 0) {
        steps_left = steps_left_opening
    } else {
        full_open_steps = (1000 * get_config("opening_duration")) / callback_ms
        full_open_steps_left = full_open_steps * (100 - get_state("position")) / 100.0

        if (channel == "full_open") {
            steps_left = full_open_steps_left
        } else {
            slightly_open_return_steps = (1000 * get_config("slightly_open_duration")) / callback_ms
            slightly_open_steps_left = full_open_steps_left - slightly_open_return_steps

            if (slightly_open_steps_left >= 0) {
                steps_left = slightly_open_steps_left
            } else {
                steps_left = -slightly_open_steps_left
                callback_id = 2 // closing direction
            }
        }
    }

    if (steps_left == 0) {
        return
    }

    set_state("steps_left", steps_left)
    if (callback_id == 1 or callback_id == 3) {
        set_output("open", true)
        set_output("close", false)
        set_state("was_opening", true)
    } else {
        set_output("open", false)
        set_output("close", true)
        set_state("was_opening", false)
    }
    callback(callback_ms_real, callback_id)

    return
}

if (channel == "full_close") {
    if (get_input("wind_alarm") or get_input("off") or get_input("dwc")) {
        return
    }

    if (get_output("close")) { // stops if in motion
        clear_callback()
        set_state("steps_left", 0)
        set_output("close", false)
        return
    }

    set_state("steps_left", steps_left_closing)
    set_output("open", false)
    set_output("close", true)
    set_state("was_opening", false)
    callback(callback_ms_real, 2)
    return
}
