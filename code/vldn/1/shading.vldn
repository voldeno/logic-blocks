callback_ms = 100
channel = get_current_channel()
value = get_current_value()

if (channel == "callback") {
    steps_left = get_state("steps_left")
    steps_left = steps_left - 1
    if (steps_left <= 0) {
        steps_left = 0
    }
    set_state("steps_left", steps_left)

    last_slats = get_output("slats")
    current_slats = last_slats

    last_position = get_output("position")
    current_position = last_position

    if (value == 1 or value == 3) { // opening callback - full_open and slightly_open
        if (get_config("slightly_open_duration") == 0) { // handle division by zero
            current_slats = 0
        } else {
            current_slats = last_slats - (((100 * callback_ms) / (get_config("slightly_open_duration") * 1000)))
        }
        if (current_slats <= 0) {
            current_slats = 0
        }

        if (current_slats == 0) { // slats fully moved, start changing position
            current_position = last_position + (((100 * callback_ms) / (get_config("opening_duration") * 1000)))
            if (current_position >= 100) {
                current_position = 100
            }
        }

        set_output("slats", current_slats)
        set_output("position", current_position)

        if (steps_left > 0) {
            callback(callback_ms, value)
        } else if (value == 1) { // full_open
            set_output("open", false)
        } else if (value == 3) { // slightly_open
            set_output("open", false)
            slightly_open_steps = (1000 * get_config("slightly_open_duration")) / callback_ms
            if (slightly_open_steps == 0) {
                return
            }
            set_output("close", true)
            set_state("steps_left", slightly_open_steps)
            callback(callback_ms, 2)
            return
        }
        return
    }

    if (value == 2) { // closing callback - full_close
        if (get_config("slightly_open_duration") == 0) { // handle division by zero
            current_slats = 100
        } else {
            current_slats = last_slats + (((100 * callback_ms) / (2 * get_config("slightly_open_duration") * 1000)))
        }
        if (current_slats >= 100) {
            current_slats = 100
        }

        if (current_slats == 100) { // slats fully moved, start changing position
            current_position = last_position - (((100 * callback_ms) / (get_config("closing_duration") * 1000)))
            if (current_position <= 0) {
                current_position = 0
            }
        }

        if (current_position == 0 and current_slats == 100 and steps_left == 0) {
            current_slats = 0
        }

        set_output("slats", current_slats)
        set_output("position", current_position)
        if (steps_left > 0) {
           callback(callback_ms, 2)
        } else {
           set_output("close", false)
        }
        return
    }

    return
}

if (channel == "part_open") {
    clear_callback()
    set_output("open", value)
    set_output("close", false)

    if (value) {
        set_state("steps_left", (1000 * get_config("opening_duration")) / callback_ms)
        callback(callback_ms, 1)
    }
    return
}

if (channel == "part_close") {
    clear_callback()
    set_output("open", false)
    set_output("close", value)

    if (value) {
        full_closing_steps = (1000 * get_config("closing_duration")) / callback_ms
        set_state("steps_left", full_closing_steps * get_output("position") / 100)
        callback(callback_ms, 2)
    }
    return
}

// pulse signals below
if (value == true) {
    return
}

if (channel == "off") {
    clear_callback()
    set_output("open", false)
    set_output("close", false)
    return
}

if (channel == "toggle") {
    if (get_output("open") or get_output("close")) { // stop on movement
        clear_callback()
        set_output("open", false)
        set_output("close", false)
    } else if (get_state("was_opening")) { // toggle to closing
        set_state("was_opening", false)
        set_output("open", false)
        set_output("close", true)

        full_closing_steps = (1000 * get_config("closing_duration")) / callback_ms
        set_state("steps_left", full_closing_steps * get_output("position") / 100)
        callback(callback_ms, 2)
    } else { // toggle to opening
        set_state("was_opening", true)
        set_output("open", true)
        set_output("close", false)

        set_state("steps_left", (1000 * get_config("opening_duration")) / callback_ms)
        callback(callback_ms, 1)
    }
    return
}

if (channel == "full_open" or channel == "slightly_open") {
    if (get_output("open")) { // stops if in motion
        clear_callback()
        set_state("steps_left", 0)
        set_output("open", false)
        return
    }

    // TODO: position should be taken into account during opening
    full_open_steps = (1000 * get_config("opening_duration")) / callback_ms
    full_open_steps_left = full_open_steps * (100 - get_output("position")) / 100
    slightly_open_return_steps = (1000 * get_config("slightly_open_duration")) / callback_ms
    slats_return_steps_to_opening = 2 * slightly_open_return_steps * get_output("slats") / 100

    if (channel == "full_open") {
        set_state("steps_left", full_open_steps_left + slats_return_steps_to_opening)
    } else if (channel == "slightly_open") {
        set_state("steps_left", full_open_steps_left + slats_return_steps_to_opening + slightly_open_return_steps)
    }
    set_output("open", true)
    set_output("close", false)
    set_output("position", get_output("position"))
    set_state("was_opening", true)

    callback_id = 1
    if (channel == "slightly_open") {
        callback_id = 3
    }
    callback(callback_ms, callback_id)

    return
}

if (channel == "full_close") {
    if (get_output("close")) { // stops if in motion
        clear_callback()
        set_state("steps_left", 0)
        set_output("close", false)
        return
    }

    full_closing_steps = (1000 * get_config("closing_duration")) / callback_ms
    slats_full_rotation_steps = (1000 * 2 * get_config("slightly_open_duration")) / callback_ms

    steps_left = full_closing_steps + slats_full_rotation_steps
    if (steps_left == 0) {
        return
    }
    set_state("steps_left", steps_left)
    set_output("open", false)
    set_output("close", true)
    set_output("position", get_output("position"))
    set_state("was_opening", false)
    callback(callback_ms, 2)
    return
}
