channel = std::get_current_channel()
value = std::get_current_value()
now = std::uptime()

if (channel == "calculate_activation_ts") {
    // TODO: add proper schedule fn
    next = time::now() + 1
    std::set_state("next_activation_ts", next)
    return
}

// inputs
air_temp = std::get_input("air_temp")
floor_temp = std::get_input("floor_temp")
outside_temp = std::get_input("outside_temp")
presence = std::get_input("presence")
dwc = std::get_input("dwc")
comfort_forced = std::get_input("comfort")
protection_forced = std::get_input("protection")

// configs
thermal_mode = std::get_config("thermal_mode") // 0=heating and cooling, 1=heating only, 2=cooling only
operation_mode = std::get_config("operation_mode") // 0=schedule, 1=manual
comfort_heating_temp = std::get_config("comfort_heating_temp")
comfort_cooling_temp = std::get_config("comfort_cooling_temp")
eco_heating_temp_diff = std::get_config("eco_heating_temp_diff")
eco_cooling_temp_diff = std::get_config("eco_cooling_temp_diff")
frost_protection_temp = std::get_config("frost_protection_temp")
overheat_protection_temp = std::get_config("overheat_protection_temp")
dwc_delay_sec = std::get_config("dwc_delay")
presence_extension_duration = std::get_config("presence_extension_duration")

last_dwc_state = std::get_state("dwc_state")
if (channel == "dwc") {
    // on DWC switch
    if ((value and !last_dwc_state) or (!value and last_dwc_state)) {
        std::clear_callback()
        std::callback(dwc_delay_sec * 1000 + 5, 0)
        std::set_state("dwc_state_change_ts", now)
        std::set_state("dwc_state", value)
    }
}
last_dwc_ts = std::get_state("dwc_state_change_ts")
dwc_duration_sec = (now - last_dwc_ts) / 1000.0

fn round2decimal(temp_deviation) {
    return math::round(100.0 * temp_deviation) / 100.0
}

// define:
// - comfort mode: 0=eco, 1=comfort, 2=protection
// - target temperatures for heating and cooling
comfort_mode = 0
target_heating_temp = 0
target_cooling_temp = 0

if (operation_mode == 0) { // schedule
    schedule_id = std::get_config("schedule")
    comfort_mode = schedule::get_entry_type(schedule_id)
}

if (comfort_mode == 1 or comfort_forced) { // comfort
    target_heating_temp = comfort_heating_temp
    target_cooling_temp = comfort_cooling_temp
} else if (comfort_mode == 2 or protection_forced) { // protection
    target_heating_temp = frost_protection_temp
    target_cooling_temp = overheat_protection_temp
} else { // no entry - default: eco
    target_heating_temp = comfort_heating_temp - eco_heating_temp_diff
    target_cooling_temp = comfort_cooling_temp + eco_cooling_temp_diff
}

// define:
// - chosen thermal mode: 0=idle, 1=heating, 2=cooling
// - temperature deviation
chosen_thermal_mode = 0 // idle
target_temp = air_temp
temp_deviation = 0.0
outside_temp_helps = false
outside_temp_sensor = outside_temp != -1000
if (air_temp < target_heating_temp and (thermal_mode == 0 or thermal_mode == 1)) {
    chosen_thermal_mode = 1 // heating
    target_temp = target_heating_temp
    temp_deviation = target_temp - air_temp // positive
    outside_temp_helps = outside_temp_sensor and (outside_temp > target_heating_temp)
}
if (air_temp > target_cooling_temp and (thermal_mode == 0 or thermal_mode == 2)) {
    chosen_thermal_mode = 2 // cooling
    target_temp = target_cooling_temp
    temp_deviation = target_temp - air_temp // negative
    outside_temp_helps = outside_temp_sensor and (outside_temp < target_cooling_temp)
}

if (!outside_temp_helps and (dwc and dwc_duration_sec > dwc_delay_sec)) {
    std::set_state("dwc_lock", true)
}
if (std::get_state("dwc_lock") and !dwc and dwc_duration_sec > dwc_delay_sec) {
    std::set_state("dwc_lock", false)
}
dwc_lock_active = std::get_state("dwc_lock")

protective_action_required = air_temp < frost_protection_temp or air_temp > overheat_protection_temp
if (dwc_lock_active and !protective_action_required) {
    std::set_output("temp_deviation", round2decimal(0.0))
    std::set_output("target_temp", round2decimal(target_temp))
    return
}

std::set_output("temp_deviation", round2decimal(temp_deviation))
std::set_output("target_temp", round2decimal(target_temp))
