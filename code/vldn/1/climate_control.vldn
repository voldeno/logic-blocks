    std::set_output("climate_1", climate_in_1)
} else {
    std::set_output("climate_1", 0)
}

if (climate_in_2 > 5) {
    std::set_output("climate_2", climate_in_2)
} else {
    std::set_output("climate_2", 0)
}

if (climate_in_3 > 5) {
    std::set_output("climate_3", climate_in_3)
} else {
    std::set_output("climate_3", 0)
}

if (climate_in_4 > 5) {
    std::set_output("climate_4", climate_in_4)
}  else {
