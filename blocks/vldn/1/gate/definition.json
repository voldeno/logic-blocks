  "config": [
    {
      "id": "gate_type",
      "type": "ENUM",
      "values": [
        "Garage door",
        "Gate (left wing)",
        "Gate (right wing)",
        "Double wing gate",
        "Sliding gate (left)",
        "Sliding gate (right)"
      ],
      "default": "0"
    },
    {
      "id": "control_mode",
      "type": "ENUM",
      "values": [
        "Direct motor control",
        "Single control: open/stop/close",
        "Single control: open/close",
        "Separate open and close pulses"
      ],
      "default": "0"
    },
    {
      "id": "opening_duration",
      "type": "NUMBER",
      "unit": "s",
      "default": "30",
      "validation": {
        "rules": [
          {
            "type": "gt",
            "value": 0
          }
        ]
      }
    },
    {
      "id": "closing_duration",
      "type": "NUMBER",
      "unit": "s",
      "default": "30",
      "validation": {
        "rules": [
          {
            "type": "gt",
            "value": 0
          }
        ]
      }
    },
    {
      "id": "partial_open_position",
      "type": "NUMBER",
      "unit": "%",
      "default": "20",
      "validation": {
        "rules": [
          {
            "type": "gte",
            "value": 0
          },
          {
            "type": "lte",
            "value": 100
          }
        ]
      }
    },
    {
      "id": "open_output_function",
      "type": "ENUM",
      "values": [
        "Open",
        "Close",
        "Open/Close",
        "Open/Stop/Close",
        "Partial open",
        "Partial open/Close"
      ],
      "default": "0",
      "visibleWhen": {
        "configId": "control_mode",
        "values": [
          "Separate open and close pulses"
        ]
      }
    },
    {
      "id": "close_output_function",
      "type": "ENUM",
      "values": [
        "Open",
        "Close",
        "Open/Close",
        "Open/Stop/Close",
        "Partial open",
        "Partial open/Close"
      ],
      "default": "1",
      "visibleWhen": {
        "configId": "control_mode",
        "values": [
          "Separate open and close pulses"
        ]
      }
    },
    {
      "id": "pulse_duration",
      "type": "NUMBER",
      "unit": "s",
      "default": "0.5",
      "visibleWhen": {
        "configId": "control_mode",
        "values": [
          "Single control: open/stop/close",
          "Single control: open/close",
          "Separate open and close pulses"
        ]
      },
      "validation": {
        "rules": [
          {
            "type": "gt",
            "value": 0
          }
        ]
      }
    },
    {
      "id": "pulse_pause",
      "type": "NUMBER",
      "unit": "s",
      "default": "0.5",
      "visibleWhen": {
        "configId": "control_mode",
        "values": [
          "Single control: open/stop/close",
          "Single control: open/close",
          "Separate open and close pulses"
        ]
      },
      "validation": {
        "rules": [
          {
            "type": "gte",
            "value": 0
          }
        ]
      }
    },
    {
      "id": "motor_lock_duration",
      "type": "NUMBER",
      "unit": "s",
      "default": "0.5",
      "visibleWhen": {
        "configId": "control_mode",
        "values": [
          "Direct motor control"
        ]
      },
      "validation": {
        "rules": [
          {
            "type": "gte",
            "value": 0
          }
        ]
      }
    }
