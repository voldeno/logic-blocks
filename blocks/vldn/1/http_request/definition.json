      "default": "0"
    },
    {
      "id": "url",
      "type": "STRING",
      "default": ""
    },
    {
      "id": "headers",
      "type": "STRING",
      "default": ""
    },
    {
      "id": "body",
      "type": "STRING",
      "default": ""
    }
  ],
  "state": [
    {
      "id": "prev_trigger",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "in_flight",
      "type": "BOOLEAN",
      "default": "false"
