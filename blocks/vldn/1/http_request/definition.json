{
  "name": "HTTP Request",
  "group": "process",
  "inputs": [
    {
      "id": "trigger",
      "abbrev": "T",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "url",
      "abbrev": "U",
      "type": "STRING",
      "default": ""
    },
    {
      "id": "headers",
      "abbrev": "H",
      "type": "STRING",
      "default": ""
    },
    {
      "id": "body",
      "abbrev": "B",
      "type": "STRING",
      "default": ""
    }
  ],
  "outputs": [
