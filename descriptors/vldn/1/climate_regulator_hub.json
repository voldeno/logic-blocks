{
  "name": "Climate regulator hub",
  "group": "process",
  "description": "Central, climate regulator hub - aggregates the heating or cooling requirements from zonal climate regulators and decides which should be enabled.",
  "inputs": [
    {
      "id": "temp_dev_zone_1",
      "name": "Temperature deviation, zone 1",
      "description": "Input for the temperature deviation output of a zonal climate controller - zone 1",
      "abbrev": "TD1",
      "type": "NUMBER",
      "default": "0"
    },
    {
      "id": "temp_dev_zone_2",
      "name": "Temperature deviation, zone 2",
      "description": "Input for the temperature deviation output of a zonal climate controller - zone 2",
      "abbrev": "TD2",
      "type": "NUMBER",
      "default": "0"
    },
    {
      "id": "temp_dev_zone_3",
      "name": "Temperature deviation, zone 3",
      "description": "Input for the temperature deviation output of a zonal climate controller - zone 3",
      "abbrev": "TD3",
      "type": "NUMBER",
      "default": "0"
    },
    {
      "id": "temp_dev_zone_4",
      "name": "Temperature deviation, zone 4",
      "description": "Input for the temperature deviation output of a zonal climate controller - zone 4",
      "abbrev": "TD4",
      "type": "NUMBER",
      "default": "0"
    }
  ],
  "outputs": [
    {
      "id": "heating_0",
      "name": "Heating",
      "description": "Heating output, central",
      "abbrev": "H",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "cooling_0",
      "name": "Cooling",
      "description": "Cooling output, central",
      "abbrev": "C",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "heating_1",
      "name": "Heating, zone 1",
      "description": "Heating output, zone 1",
      "abbrev": "H1",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "cooling_1",
      "name": "Cooling, zone 1",
      "description": "Cooling output, zone 1",
      "abbrev": "C1",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "heating_2",
      "name": "Heating, zone 2",
      "description": "Heating output, zone 2",
      "abbrev": "H2",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "cooling_2",
      "name": "Cooling, zone 2",
      "description": "Cooling output, zone 2",
      "abbrev": "C2",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "heating_3",
      "name": "Heating, zone 3",
      "description": "Heating output, zone 3",
      "abbrev": "H3",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "cooling_3",
      "name": "Cooling, zone 3",
      "description": "Cooling output, zone 3",
      "abbrev": "C3",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "heating_4",
      "name": "Heating, zone 4",
      "description": "Heating output, zone 4",
      "abbrev": "H4",
      "type": "BOOLEAN",
      "default": "false"
    },
    {
      "id": "cooling_4",
      "name": "Cooling, zone 4",
      "description": "Cooling output, zone 4",
      "abbrev": "C4",
      "type": "BOOLEAN",
      "default": "false"
    }
  ],
  "config": [
    {
      "id": "act_threshold_single",
      "name": "Activation threshold - single",
      "description": "Threshold of the single input temperature deviation below which the block stays idle. After activation the block aims to zero all the temp. deviations.",
      "type": "NUMBER",
      "default": "1.0",
      "validation": {
        "rules": [
          {
            "type": "gte",
            "value": 0
          }
        ]
      }
    },
    {
      "id": "act_threshold_sum",
      "name": "Activation threshold - sum",
      "description": "Threshold of the sum of all temperature deviation inputs below which the block stays idle. After activation the block aims to zero all the temp. deviations.",
      "type": "NUMBER",
      "default": "2.0",
      "validation": {
        "rules": [
          {
            "type": "gte",
            "value": 0
          }
        ]
      }
    }
  ],
  "state": [
  ]
}
